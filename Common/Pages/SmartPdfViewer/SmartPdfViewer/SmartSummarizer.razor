@page "/summarizer"

@using Syncfusion.Blazor
@using Syncfusion.Blazor.SmartPdfViewer
@using Syncfusion.Blazor.SfPdfViewer
@using Syncfusion.Blazor.Spinner

@*Hidden:Lines*@
@inherits SampleBaseComponent
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@*End:Hidden*@
<SampleDescription>
    <p>
        This sample demonstrates how the Smart PDF Viewer uses AI to perform PDF summarization and Q&A. Open the <strong>AI AssistView</strong> from the viewer sidebar to generate a summary of the document. After the summary is created, you can ask questions using your own queries or AI-suggested prompts.
    </p>
    <p>
        Explore our <strong>Smart PDF Viewer demos</strong> with limited AI token usage directly in your browser. To try these features locally with your own API key, visit the
        <a href="https://github.com/SyncfusionExamples/blazor-smart-pdf-viewer-examples" target="_blank" aria-label="Navigate to the Syncfusion Smart AI Samples GitHub repository">
            <strong>Syncfusion Smart PDF Viewer samples</strong>
        </a> on GitHub.
    </p>
</SampleDescription>
<ActionDescription>
    <p>This sample demonstrates how the Smart PDF Viewer uses AI to perform PDF summarization and Q&A on documents. Users can generate document summaries with highlighted key points and ask questions using custom queries or AI-suggested prompts for rapid information retrieval.</p>

    <p><strong>Key Features</strong></p>
    <ul>
        <li><strong>PDF summarization</strong> - Generate concise overviews of documents with AI-highlighted key points</li>
        <li><strong>AI-powered Q&A</strong> - Ask questions using custom queries or AI-suggested prompts to locate specific information</li>
        <li><strong>Real-time streaming</strong> - Use <code>AssistViewSettings</code> with <code>StreamResponse</code> enabled for progressive answer generation</li>
        <li><strong>Complex content analysis</strong> - Quickly understand complex content through intelligent summarization</li>
        <li><strong>Document understanding</strong> - Extract key insights and context from PDF documents automatically</li>
        <li><strong>AssistView panel</strong> - Access the AI Assistant from the viewer sidebar for document analysis</li>
    </ul>

    <p><strong>Documentation Links</strong></p>
    <ul>
        <li><a target="_blank" href="https://help.syncfusion.com/document-processing/pdf/smart-pdf-viewer/blazor/document-summarizer">Document Summarizer Overview</a></li>
        <li><a target="_blank" href="https://help.syncfusion.com/document-processing/pdf/smart-pdf-viewer/overview">Smart PDF Viewer Overview</a></li>
    </ul>

    <p><strong>More Resources</strong></p>
    <ul>
        <li><a target="_blank" href="https://help.syncfusion.com/document-processing/pdf/smart-pdf-viewer/blazor/getting-started/web-app">Getting Started - Blazor Web App</a></li>
        <li><a target="_blank" href="https://help.syncfusion.com/document-processing/pdf/smart-pdf-viewer/blazor/getting-started/ollama-service">Getting Started - Blazor Web App with Ollama</a></li>
        <li><a target="_blank" href="https://www.syncfusion.com/pdf-viewer-sdk/blazor-pdf-viewer">Blazor PDF Viewer Overview</a></li>
    </ul>
</ActionDescription>

@*Hidden:Lines*@
<AINotification></AINotification>
@*End:Hidden*@

@*Hidden:Lines*@
<AIToastNotification></AIToastNotification>
@*End:Hidden*@

@*Hidden:Lines*@
<div class="col-lg-12 control-section" id="default">
    <div class="content-wrapper">
        <div class="control-section">
            @*End:Hidden*@
            <SfSpinner Size="40" Type="SpinnerType.Bootstrap5" Visible="isSpinnerVisible"></SfSpinner>
            <div class="pdf-viewer-shell @(pdfReady ? "visible" : "")">
            <SfSmartPdfViewer id="pdf-viewer" @ref="ViewerInstance" DocumentPath="@DocumentPath" Height="640px" Width="100%">
                <AssistViewSettings StreamResponse="true" ></AssistViewSettings>
                <SmartRedactSettings Enable="false"></SmartRedactSettings>
                <SmartFillSettings Enable="false"></SmartFillSettings>
                <PdfViewerEvents DocumentLoaded="DocumentLoaded"></PdfViewerEvents>
            </SfSmartPdfViewer>
            </div>
            @*Hidden:Lines*@
        </div>
    </div>
</div>
@*End:Hidden*@
@code {
    SfSmartPdfViewer? ViewerInstance { get; set; }
    private bool pdfReady = false;
    private bool isSpinnerVisible = true;
    public string DocumentPath = "https://cdn.syncfusion.com/content/pdf/gis-succinctly.pdf";
    private async void DocumentLoaded(LoadEventArgs args)
    {
        isSpinnerVisible = false;
        pdfReady = true;
        await ViewerInstance!.ToggleItemByIndex(0);
    }
}